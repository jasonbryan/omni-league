{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "navigationRequestStrategy": "performance",
  "assetGroups": [
    {
      "name": "shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.csr.html",
          "/manifest.webmanifest",
          "/favicon.ico",
          "/main-*.js",
          "/chunk-*.js",
          "/polyfills-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/media/**", "/icons/**"] }
    }
  ]
}
