{
  "name": "omni-league",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/ng-convex.mjs serve",
    "build": "node scripts/ng-convex.mjs build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:serial": "ng test --watch=false --runner-config=vitest.serial.config.mts",
    "test:convex": "vitest run --config vitest.config.mts",
    "serve:ssr": "node dist/omni-league/server/server.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.tooling.json && tsc -p convex/tsconfig.json"
  },
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.11.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.20.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "esbuild": false,
    "lmdb": false,
    "msgpackr-extract": false,
    "@parcel/watcher": false,
    "fsevents": false
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.1",
    "convex": "^1.46.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^26.0.0",
    "angular-eslint": "22.5.0",
    "convex-test": "^0.0.60",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.0"
  }
}
