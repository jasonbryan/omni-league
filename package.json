{
  "name": "omni-league",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/ng-convex.mjs serve",
    "build": "node scripts/ng-convex.mjs build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:serial": "ng test --watch=false --runner-config=vitest.serial.config.mts",
    "test:convex": "vitest run --config vitest.config.mts",
    "test:scripts": "node --test --test-timeout=60000 \"scripts/**/*.test.mjs\"",
    "e2e": "node scripts/e2e.mjs",
    "e2e:affected": "node scripts/e2e-affected-local.mjs",
    "e2e:screenshots": "npm run e2e -- e2e/screenshot.spec.ts",
    "serve:ssr": "node scripts/serve-ssr.mjs",
    "design:css": "node scripts/inline-mockup-kit.mjs",
    "icons": "node scripts/build-icons.mjs",
    "previews:clean": "node scripts/clean-previews.mjs",
    "lint": "eslint . --max-warnings=0 && node scripts/comment-refs.mjs && node scripts/radius-classes.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.tooling.json && tsc -p convex/tsconfig.json"
  },
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.11.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.20.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "esbuild": false,
    "lmdb": false,
    "msgpackr-extract": false,
    "@parcel/watcher": false,
    "fsevents": false
  },
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-server": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/service-worker": "^22.2.5",
    "@angular/ssr": "^22.2.6",
    "@block65/webcrypto-web-push": "2.0.0",
    "@convex-dev/better-auth": "^0.13.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@noble/hashes": "^2.4.0",
    "@spartan-ng/brain": "^1.9.0",
    "better-auth": "~1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@axe-core/playwright": "~4.14.0",
    "@convex-dev/eslint-plugin": "^5.0.1",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@netlify/angular-runtime": "4.0.0",
    "@playwright/test": "~1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "angular-eslint": "22.6.0",
    "convex-test": "^0.0.67",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
