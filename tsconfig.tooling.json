/* Root tooling files (vitest.config.mts, later playwright.config.ts and e2e/) for typecheck and typed linting (ADR 0002). */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["*.ts", "*.mts", "e2e/**/*.ts"]
}
